* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f5f3ef;
    color: #292929;
    line-height: 1.6;
}

header {
    background-color: #263b50;
    color: white;
    padding: 20px 5%;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
}

header img {
    width: 64px;
    height: 64px;
}

.header-title {
    flex: 1;
}

.header-title h2 {
    font-size: 24px;
}

.header-title p {
    font-size: 13px;
    color: #d5dce3;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 25px;
    flex-wrap: wrap;
}

nav a {
    color: white;
    text-decoration: none;
    font-size: 16px;
}

nav a:hover {
    color: #e6b96b;
}

main {
    max-width: 1000px;
    margin: 40px auto;
    padding: 0 25px;
}

section {
    margin-bottom: 35px;
}

h1, h2, h3 {
    color: #263b50;
    margin-bottom: 15px;
}

h1 {
    font-size: 32px;
}

h2 {
    font-size: 26px;
}

h3 {
    font-size: 20px;
}

p {
    margin-bottom: 15px;
}

figure {
    text-align: center;
    margin: 25px 0;
}

figure img {
    max-width: 100%;
    height: auto;
}

figcaption {
    font-size: 14px;
    color: #777;
    margin-top: 8px;
}

hr {
    border: none;
    border-top: 1px solid #ccc;
    margin: 30px 0;
}

footer {
    background-color: #263b50;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 50px;
}

footer p {
    margin: 5px;
}
